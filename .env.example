# Copy this file to ".env" only if you want to change a default. IntelliForm needs NO API keys or passwords.
# INTELLIFORM_HOST=127.0.0.1        # keep this; the dashboard has no login, so it must stay local
# INTELLIFORM_PORT=5000
# INTELLIFORM_HEADLESS=false        # true hides the browser window (you then cannot review the form by eye)
# INTELLIFORM_INPUT_TIMEOUT=600     # seconds the agent waits for your answers
# INTELLIFORM_REVIEW_TIMEOUT=1800   # seconds the browser stays open for your final review
# INTELLIFORM_NAV_TIMEOUT=25        # seconds allowed for a page to load
# INTELLIFORM_DATA_DIR=             # where profile.json is stored (default: the data folder here)
